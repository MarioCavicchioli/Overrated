ANTHROPIC_API_KEY=
# wrkspc_... ; needed when the API key is not scoped to one workspace (ant reads it too)
ANTHROPIC_WORKSPACE_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATA_SERVICE_URL=
# shared secret: agents send it as the X-API-Key header
DATA_SERVICE_KEY=
# default per-session token budget
SESSION_TOKEN_BUDGET=200000
# orchestrator: sqlite until the Supabase project is ready, then supabase
STORE_BACKEND=sqlite
# bearer token the app's server side sends to the orchestrator API
ORCHESTRATOR_API_TOKEN=

# Caseworker Managed Agent configuration
CASEWORKER_AGENT_ID=
MANAGED_AGENT_ENVIRONMENT_ID=
CASEWORKER_MAX_LIST_COST_MINOR_UNITS=200
# Playbook Keeper Managed Agent configuration
PLAYBOOK_KEEPER_AGENT_ID=
PLAYBOOK_KEEPER_MAX_LIST_COST_MINOR_UNITS=300

# Person 2's overrated workspace (Scout + Case builder + advocate); key from Person 2, never commit it
OVERRATED_API_KEY=
OVERRATED_WORKSPACE_ID=
# data tools: mock (fake Hackney streets) or http (Person 1's data service over the real VOA lists)
DATA_BACKEND=http
